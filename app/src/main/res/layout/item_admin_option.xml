<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_rounded_border"
    android:layout_marginBottom="8dp">

    <RadioButton
        android:id="@+id/radio_is_correct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opsi A (Jawaban Benar)"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Teks Opsi">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_option_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Media URL Opsi">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_option_media_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
