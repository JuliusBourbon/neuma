<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Asset Badge Icon dari Figma -->
        <ImageView
            android:id="@+id/ivBadge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Achievement Badge"
            tools:src="@drawable/ic_badge_active" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <!-- Judul Achievement -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Si Paling Rajin" />

            <!-- Deskripsi Achievement -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:textColor="#6B7280"
                android:textSize="12sp"
                tools:text="Hebat! Kamu belajar BISINDO 3 hari berturut-turut tanpa bolos." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
