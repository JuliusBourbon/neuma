<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/custom_bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/primary"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:weightSum="4">

    <!-- Menu 1: Home -->
    <FrameLayout
        android:id="@+id/menu_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/iv_menu_home"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_nav_home" />
    </FrameLayout>

    <!-- Menu 2: Misi -->
    <FrameLayout
        android:id="@+id/menu_misi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/iv_menu_misi"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_nav_misi"/>
    </FrameLayout>

    <!-- Menu 3: Pencapaian -->
    <FrameLayout
        android:id="@+id/menu_pencapaian"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/iv_menu_pencapaian"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_nav_pencapaian" />
    </FrameLayout>

    <!-- Menu 4: Profile -->
    <FrameLayout
        android:id="@+id/menu_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/iv_menu_profile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_nav_profile" />
    </FrameLayout>

</LinearLayout>