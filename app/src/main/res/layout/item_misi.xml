<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_misi_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:text="Kumpulkan 3 huruf BISINDO"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_chest" />

    <!-- Container Progress Bar Kapsul -->
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_misi_title"
        app:layout_constraintEnd_toStartOf="@id/iv_chest">

        <ProgressBar
            android:id="@+id/pb_misi"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progressDrawable="@drawable/bg_progress_misi"
            android:progress="33"
            android:max="100" />

        <TextView
            android:id="@+id/tv_misi_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins"
            android:text="1/3"
            android:textColor="#555555"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Peti Misi -->
    <ImageView
        android:id="@+id/iv_chest"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_chest_active"
        android:contentDescription="Ikon Peti Harta Karun"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
