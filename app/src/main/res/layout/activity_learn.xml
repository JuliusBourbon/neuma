<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:fitsSystemWindows="true">

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_bar_learn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Attempt Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar_attempt"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_attempt"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MATERIAL SECTION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_material"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_material_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPE MATERI"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_material_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Judul Materi"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_material_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_material_media"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_material_content"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_material_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Isi konten materi di sini..."
            android:textColor="@color/black"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/tv_material_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layout_material_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_prev_material"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="KEMBALI"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="@color/primary"
                app:strokeWidth="2dp"
                app:cornerRadius="14dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_next_material"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="LANJUT"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- QUIZ SECTION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_quiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/tv_quiz_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UJI KEMAMPUANMU"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_question_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pertanyaan..."
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_quiz_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/iv_question_media"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toBottomOf="@id/tv_question_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- For MULTIPLE_CHOICE -->
        <GridLayout
            android:id="@+id/layout_options_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:columnCount="2"
            app:layout_constraintBottom_toTopOf="@id/btn_submit_answer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- For TRUE_FALSE_VISUAL -->
        <LinearLayout
            android:id="@+id/layout_true_false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btn_submit_answer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btn_true"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_check_white"
                android:scaleType="center"
                android:background="@drawable/bg_btn_true"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/btn_false"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_x_white"
                android:scaleType="center"
                android:background="@drawable/bg_btn_false"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- For SIGN_PRACTICE: Camera Container -->
        <FrameLayout
            android:id="@+id/layout_camera_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:background="@drawable/bg_camera_container"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/iv_question_media"
            app:layout_constraintBottom_toTopOf="@id/btn_submit_answer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.example.neuma.OverlayView
                android:id="@+id/overlay_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Detection Label -->
            <TextView
                android:id="@+id/tv_detection_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#CC000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Arahkan kamera ke tangan Anda"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Hold Progress Bar overlay at bottom of camera -->
            <ProgressBar
                android:id="@+id/progress_hold"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_camera_progress_border"
                android:visibility="gone" />

        </FrameLayout>

        <Button
            android:id="@+id/btn_submit_answer"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="SUBMIT"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toTopOf="@id/btn_skip_question"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_skip_question"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="LEWATI SOAL INI"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
